# Deployment mode. Use compose.external-postgres.yaml for an existing database.
COMPOSE_FILE=compose.yaml

# Containers are named <instance>-api, <instance>-web, and optionally <instance>-postgres.
# Compose also prefixes network and volume names with this instance name.
# Keep shadowcook for an existing default deployment to retain its database volume.
# Use a different name for every additional instance on the same Docker server.
COMPOSE_PROJECT_NAME=shadowcook

# Docker fetches this repository and ref as its build context.
SHADOWCOOK_SOURCE_REPOSITORY_URL=https://github.com/Shadowcook/shadowcook.git
SHADOWCOOK_SOURCE_REF=main
# upgrade.sh resolves its Git-ref parameter to a full commit hash and updates
# this value before recreating the web container.
SHADOWCOOK_BUILD_COMMIT=replace-with-full-commit-hash
# New deployments use an instance-specific image tag automatically.
# Existing deployments may keep their current tag, such as local.
# Never share application image tags between instances.
SHADOWCOOK_IMAGE_TAG=${COMPOSE_PROJECT_NAME}

# Public URL served to users, normally by a TLS reverse proxy.
PUBLIC_WEB_ORIGIN=https://shadowcook.example.com
# Defaults to ${PUBLIC_WEB_ORIGIN}/api when omitted.
# PUBLIC_API_ORIGIN=https://shadowcook.example.com/api

# Public web listener. Keep loopback when a host reverse proxy terminates TLS.
# Each instance needs a different host port or host bind address.
SHADOWCOOK_HTTP_BIND=127.0.0.1
SHADOWCOOK_HTTP_PORT=4321

# Trusted proxy IPs/CIDRs. Defaults cover the private Compose network and host
# reverse proxy. Narrow these ranges when other untrusted private peers exist.
SHADOWCOOK_API_TRUSTED_PROXIES=loopback,uniquelocal
SHADOWCOOK_WEB_TRUSTED_PROXIES=loopback,uniquelocal

# The API reads the base64-encoded 32-byte key from this Docker secret file.
# Generate it once with: openssl rand -base64 32 > secrets/instance_secret_key
INSTANCE_SECRET_KEY_FILE=./secrets/instance_secret_key

# The initial administrator is created once. Its generated password is written
# to the API container log; change it immediately after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Optional Cloudflare Turnstile protection for public registration. Configure
# both values, recreate the API container, then enable it in Administration.
# TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
# TURNSTILE_SECRET=replace-with-cloudflare-secret

# Bundled PostgreSQL mode: used by compose.yaml.
POSTGRES_DB=shadowcook
POSTGRES_USER=shadowcook
POSTGRES_PASSWORD=replace-with-a-long-random-password
SHADOWCOOK_POSTGRES_BIND=127.0.0.1
# Each bundled instance needs a different PostgreSQL host port or bind address.
SHADOWCOOK_POSTGRES_PORT=5432

# Existing PostgreSQL mode: set COMPOSE_FILE=compose.external-postgres.yaml.
# Set the external database connection string. Percent-encode reserved URL
# characters in the username, password, database name, or host.
# DATABASE_URL=postgresql://shadowcook:replace-with-password@postgres.example.com:5432/shadowcook
