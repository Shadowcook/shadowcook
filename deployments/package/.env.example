# Deployment mode. Use compose.external-postgres.yaml for an existing database.
COMPOSE_FILE=compose.yaml

# Docker fetches this repository and ref as its build context.
SHADOWCOOK_SOURCE_REPOSITORY_URL=https://github.com/Shadowcook/shadowcook.git
SHADOWCOOK_SOURCE_REF=main
# upgrade.sh resolves its Git-ref parameter to a full commit hash and updates
# both build variables before rebuilding the containers.
SHADOWCOOK_BUILD_COMMIT=replace-with-full-commit-hash
SHADOWCOOK_IMAGE_TAG=local

# Public URL served to users, normally by a TLS reverse proxy.
PUBLIC_WEB_ORIGIN=https://shadowcook.example.com
# Defaults to ${PUBLIC_WEB_ORIGIN}/api when omitted.
# PUBLIC_API_ORIGIN=https://shadowcook.example.com/api

# Public web listener. Keep loopback when a host reverse proxy terminates TLS.
SHADOWCOOK_HTTP_BIND=127.0.0.1
SHADOWCOOK_HTTP_PORT=4321

# The API reads the base64-encoded 32-byte key from this Docker secret file.
# Generate it once with: openssl rand -base64 32 > secrets/instance_secret_key
INSTANCE_SECRET_KEY_FILE=./secrets/instance_secret_key

# The initial administrator is created once. Its generated password is written
# to the API container log; change it immediately after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Bundled PostgreSQL mode: used by compose.yaml.
POSTGRES_DB=shadowcook
POSTGRES_USER=shadowcook
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Connection string used by the API. Percent-encode reserved URL characters in
# the username, password, database name, or host. This password must identify
# the same PostgreSQL user as POSTGRES_USER and POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://shadowcook:replace-with-a-long-random-password@postgres:5432/shadowcook
SHADOWCOOK_POSTGRES_BIND=127.0.0.1
SHADOWCOOK_POSTGRES_PORT=5432

# Existing PostgreSQL mode: set COMPOSE_FILE=compose.external-postgres.yaml.
# Replace DATABASE_URL above with the existing database connection string.
