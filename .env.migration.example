# Read-only legacy HSQLDB source.
SOURCE_DB_URL=jdbc:hsqldb:hsql://legacy-host/database
SOURCE_DB_USERNAME=read-only-user
SOURCE_DB_PASSWORD=read-only-password

# Shadowcook 2 PostgreSQL target and existing empty tenant.
TARGET_DB_URL=postgresql://localhost:5432/shadowcook
TARGET_DB_USERNAME=shadowcook
TARGET_DB_PASSWORD=change-me
TARGET_DB_TENANT_SLUG=target-tenant

# Optional development-content seed output path. Defaults to development-content-seed.json.
# DEVELOPMENT_CONTENT_SEED_PATH=development-content-seed.json

# Optional target-tenant author override. The single Owner is used by default.
# TARGET_DB_AUTHOR_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000

# Optional when the HSQLDB JDBC driver exists in the local Maven repository.
# SOURCE_DB_HSQLDB_JAR=/path/to/hsqldb.jar
