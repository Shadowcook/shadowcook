---
import Brand from '../../../components/Brand.astro';
import BuildFooter from '../../../components/BuildFooter.astro';
import HeadBar from '../../../components/HeadBar';
import { translations } from '../../../i18n';
import type { Locale, Translation } from '../../../i18n';
import { localizedIngredientName } from '../../../i18n/ingredient-localization';
import { categoryPath } from '../model/routing';
import { aggregateShoppingList, formatShoppingListAmount } from '../model/shopping-list';
import type { AggregatedAmount, ShoppingListItem } from '../model/shopping-list';
import type {
  Category,
  CookbookResponse,
  IngredientUsage,
  Recipe,
  RecipeDetail,
  RecipeVariant,
} from '../model/types';
import { recipeIngredientText, recipeJsonLd } from './recipe-structured-data';
import '../../../styles/global.css';
import '../../../styles/cookbook.css';

interface Properties {
  cookbook: CookbookResponse;
  categoryId: string | null;
  locale: Locale;
  recipe: RecipeDetail;
}

const { cookbook, categoryId, locale, recipe } = Astro.props;
const text: Translation = translations[locale];
const buildCommit: string | undefined = import.meta.env.PUBLIC_BUILD_COMMIT;
const cookbookName: string = cookbook.tenant?.display_name ?? text.dashboard.cookbook;
const canonicalUrl: string = `${Astro.url.origin}${Astro.url.pathname}`;
const categoryIds: string[] = recipeCategories(cookbook, recipe.public_id);
const shoppingListItems: ShoppingListItem[] = aggregateShoppingList(recipe);
const breadcrumbCategories: Category[] = categoryTrail(categoryId);
const structuredData = recipeJsonLd(
  recipe,
  cookbook.categories,
  categoryIds,
  cookbookName,
  canonicalUrl,
  text,
);
const structuredDataJson: string = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const overviewPath: string = categoryId === null ? `/${tenantSlug()}` : categoryUrl(categoryId);

function tenantSlug(): string {
  const segment: string | undefined = Astro.url.pathname.split('/').filter(Boolean)[0];
  return segment === undefined ? '' : encodeURIComponent(decodeURIComponent(segment));
}

function recipeCategories(response: CookbookResponse, publicId: string): string[] {
  const recipeSummary = response.recipes.find(
    (candidate: Recipe): boolean => candidate.public_id === publicId,
  );
  return recipeSummary?.category_public_ids ?? [];
}

function categoryUrl(id: string): string {
  const segments: string[] | null = categoryPath(cookbook.categories, id);
  return segments === null ? `/${tenantSlug()}` : `/${tenantSlug()}/${segments.map(encodeURIComponent).join('/')}`;
}

function variantUrl(slug: string, isDefault: boolean): string {
  if (isDefault) return `${overviewPath}/recipes/${encodeURIComponent(recipe.slug)}`;
  const defaultVariant = recipe.variants.find(
    (variant: RecipeVariant): boolean => variant.is_default,
  );
  const base: string = variantUrl(defaultVariant?.slug ?? recipe.slug, true);
  return `${base}/${encodeURIComponent(slug)}`;
}

function categoryTrail(selectedCategoryId: string | null): Category[] {
  if (selectedCategoryId === null) return [];

  const trail: Category[] = [];
  let category: Category | undefined = cookbook.categories.find(
    (candidate: Category): boolean => candidate.public_id === selectedCategoryId,
  );
  while (category !== undefined) {
    trail.unshift(category);
    category =
      category.parent_public_id === null
        ? undefined
        : cookbook.categories.find(
            (candidate: Category): boolean => candidate.public_id === category?.parent_public_id,
          );
  }
  return trail;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={recipe.summary ?? text.metadata.description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{recipe.title} · {text.metadata.title}</title>
    <script type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <HeadBar client:load locale={locale} />
    <main class="application-shell">
      <Brand name={text.brandName} />
      <article class="recipe-detail">
        <a class="button--secondary recipe-detail__back" href={overviewPath}>
          {text.dashboard.backToRecipes}
        </a>
        <nav class="breadcrumb" aria-label={text.dashboard.breadcrumb}>
          <ol>
            <li><a href={`/${tenantSlug()}`}>{cookbookName}</a></li>
            {breadcrumbCategories.map((category: Category) => (
              <li><a href={categoryUrl(category.public_id)}>{category.name}</a></li>
            ))}
            <li><span aria-current="page">{recipe.title}</span></li>
          </ol>
        </nav>
        <header>
          <p class="eyebrow">{cookbookName}</p>
          <h1>{recipe.title}</h1>
          {recipe.summary === null ? null : <p class="recipe-detail__summary">{recipe.summary}</p>}
        </header>
        <div class="recipe-detail__overview">
          <aside class="recipe-shopping-list" aria-label={text.dashboard.shoppingList}>
            <p class="eyebrow">{text.dashboard.shoppingList}</p>
            <ul>
              {shoppingListItems.map((item: ShoppingListItem) => {
                const ingredientName: string = localizedIngredientName(
                  text,
                  item.ingredient.ingredient_localization_key,
                  item.ingredient.ingredient_name,
                );
                const quantities: string[] = Array.from(item.amountsByUnit.values())
                  .map((amount: AggregatedAmount): string => formatShoppingListAmount(amount, text))
                  .filter((amount: string): boolean => amount.length > 0);
                return (
                  <li>
                    <span>
                      {ingredientName}
                      {item.ingredient.is_optional ? <em>{text.dashboard.optional}</em> : null}
                    </span>
                    {quantities.length > 0 ? <strong>{quantities.join(', ')}</strong> : null}
                  </li>
                );
              })}
            </ul>
          </aside>
        </div>
        {
          recipe.variants.length > 1 ? (
            <nav class="recipe-page__variants" data-variant-selector data-variant-label={text.recipeEditor.variant}>
              <ul>
                {recipe.variants.filter(
                  (variant: RecipeVariant): boolean => variant.is_default || variant.is_visible,
                ).map((variant: RecipeVariant) => (
                  <li>
                    <a
                      href={variantUrl(variant.slug, variant.is_default)}
                      aria-current={variant.slug === recipe.selectedVariant ? 'page' : undefined}
                    >{variant.name}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ) : null
        }
        <div class="recipe-detail__heading">
          <p class="eyebrow">{text.dashboard.ingredients}</p>
          <p class="eyebrow">{text.dashboard.preparation}</p>
        </div>
        <ol class="recipe-steps">
          {
            recipe.steps.map((step, index: number) => (
              <li>
                <ul>
                  {step.ingredients.map((ingredient: IngredientUsage) => (
                    <li>
                      <span class="recipe-step-entry">{recipeIngredientText(ingredient, text)}</span>
                      {ingredient.is_optional ? <em>{text.dashboard.optional}</em> : null}
                    </li>
                  ))}
                </ul>
                <section>
                  <p class="recipe-step__number">{text.dashboard.step} {index + 1}</p>
                  <p>{step.instruction}</p>
                </section>
              </li>
            ))
          }
        </ol>
      </article>
    </main>
    <BuildFooter buildCommit={buildCommit} text={text} />
  </body>
</html>

<script>
  const variantNavigations: NodeListOf<HTMLElement> = document.querySelectorAll('[data-variant-selector]');

  for (const navigation of variantNavigations) {
    const links: HTMLAnchorElement[] = Array.from(navigation.querySelectorAll('a'));
    if (links.length === 0) continue;

    const select: HTMLSelectElement = document.createElement('select');
    select.setAttribute('aria-label', navigation.dataset.variantLabel ?? '');
    for (const link of links) {
      const option: HTMLOptionElement = document.createElement('option');
      option.value = link.href;
      option.textContent = link.textContent;
      option.selected = link.getAttribute('aria-current') === 'page';
      select.append(option);
    }
    select.addEventListener('change', (event: Event): void => {
      const control: HTMLSelectElement = event.currentTarget as HTMLSelectElement;
      window.location.assign(control.value);
    });
    navigation.append(select);
    navigation.classList.add('recipe-page__variants--enhanced');
  }
</script>
