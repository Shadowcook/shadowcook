---
import ApplicationPage from '../components/ApplicationPage.astro';
import RecipePage from '../features/cookbook/server/RecipePage.astro';
import { loadServerRecipePage } from '../lib/server/cookbook';
import { resolveLocale } from '../i18n';
import type { Locale } from '../i18n';

export const prerender = false;

const recipePage = await loadServerRecipePage(
  Astro.url.pathname,
  Astro.request.headers.get('cookie'),
);
const locale: Locale = resolveLocale(import.meta.env.PUBLIC_DEFAULT_LOCALE);
---

{
  recipePage === null ? (
    <ApplicationPage path={Astro.url.pathname} />
  ) : (
    <RecipePage
      cookbook={recipePage.cookbook}
      categoryId={recipePage.location.categoryId}
      locale={locale}
      recipe={recipePage.recipe}
    />
  )
}
