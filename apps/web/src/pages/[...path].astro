---
import ErrorPage from '../components/errors/ErrorPage.astro';
import { ApiRequestError } from '../lib/api/client';
import { isKnownSystemPage, isSystemPath } from '../lib/system-routing';
import ApplicationPage from '../components/ApplicationPage.astro';
import LegalDocumentPage from '../components/LegalDocumentPage.astro';
import CookbookPage from '../features/cookbook/server/CookbookPage.astro';
import RecipePage from '../features/cookbook/server/RecipePage.astro';
import { loadServerCookbookPage, loadServerRecipePage } from '../lib/server/cookbook';
import { loadLegalDocuments } from '../lib/server/legal-documents';
import { translations } from '../i18n';
import { resolveRequestLocale } from '../i18n/locale-preference';
import type { Locale } from '../i18n';

export const prerender = false;

let recipePage: Awaited<ReturnType<typeof loadServerRecipePage>> = null;
let cookbookPage: Awaited<ReturnType<typeof loadServerCookbookPage>> = null;
let pathNotFound: boolean = false;
let pageError: ApiRequestError | null = null;
try {
  recipePage = await loadServerRecipePage(Astro.url.pathname, Astro.request.headers.get('cookie'));
  cookbookPage =
    recipePage === null
      ? await loadServerCookbookPage(
          Astro.url.pathname,
          Astro.request.headers.get('cookie'),
          isTenantRoot(Astro.url.pathname),
          Astro.url.search,
          (): void => {
            pathNotFound = true;
          },
        )
      : null;
} catch (error: unknown) {
  pageError =
    error instanceof ApiRequestError ? error : new ApiRequestError('INTERNAL_SERVER_ERROR', 500);
}
const locale: Locale = resolveRequestLocale(
  Astro.request.headers.get('cookie'),
  import.meta.env.PUBLIC_DEFAULT_LOCALE,
);
const legalDocuments =
  Astro.url.pathname === '/privacy-statement' || Astro.url.pathname === '/imprint'
    ? await loadLegalDocuments()
    : null;

if (isSystemPath(Astro.url.pathname) && !isKnownSystemPage(Astro.url.pathname)) pathNotFound = true;
if (pathNotFound && pageError === null) pageError = new ApiRequestError('NOT_FOUND', 404);
if (pageError !== null) {
  Astro.response.status = pageError.status ?? 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

function isTenantRoot(pathname: string): boolean {
  return pathname.split('/').filter((segment: string): boolean => segment.length > 0).length === 1;
}
---

{
  pageError !== null ? (
    <ErrorPage
      locale={locale}
      status={pageError.status ?? 503}
      requestId={pageError.requestId}
      retryAfterSeconds={pageError.retryAfterSeconds}
    />
  ) : Astro.url.pathname === '/privacy-statement' ? (
    <LegalDocumentPage
      locale={locale}
      markdown={legalDocuments?.privacyStatementMarkdown ?? ''}
      title={translations[locale].buildFooter.privacyStatement}
    />
  ) : Astro.url.pathname === '/imprint' ? (
    <LegalDocumentPage
      locale={locale}
      markdown={legalDocuments?.imprintMarkdown ?? ''}
      title={translations[locale].buildFooter.imprint}
    />
  ) : recipePage !== null ? (
    <RecipePage
      cookbook={recipePage.cookbook}
      categoryId={recipePage.location.categoryId}
      locale={locale}
      recipe={recipePage.recipe}
    />
  ) : cookbookPage !== null ? (
    <CookbookPage
      cookbook={cookbookPage.cookbook}
      categoryId={cookbookPage.location.categoryId}
      locale={locale}
    />
  ) : (
    <ApplicationPage path={Astro.url.pathname} notFound={pathNotFound} />
  )
}
