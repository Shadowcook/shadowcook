---
import CookbookScreen from '../features/cookbook/CookbookScreen';
import AdminArea from '../features/admin/AdminArea';
import InvitationScreen from './InvitationScreen';
import TenantSelection from './TenantSelection';
import PasswordResetScreen from './PasswordResetScreen';
import UserInvitationScreen from './UserInvitationScreen';
import RegistrationScreen, { VerificationScreen } from './RegistrationScreen';
import BuildFooter from './BuildFooter.astro';
import Favicon from './Favicon.astro';
import HeadBar from './HeadBar';
import { resolveLocale, translations } from '../i18n';
import type { Locale } from '../i18n';
import { buildCommit } from '../lib/server/build-info';
import '../styles/global.css';

const locale: Locale = resolveLocale(import.meta.env.PUBLIC_DEFAULT_LOCALE);
const text = translations[locale];
const deployedBuildCommit: string | undefined = buildCommit();
interface Properties {
  path: string;
}
const { path } = Astro.props;
const isAdministrationPath: boolean = path === '/admin' || path.startsWith('/admin/');
const isTenantManagementPath: boolean =
  path.endsWith('/drafts') ||
  path.endsWith('/categories') ||
  path.includes('/manage/') ||
  path.endsWith('/recipes/new') ||
  /\/recipes\/[^/]+\/edit$/.test(path);
const isCookbookPath: boolean =
  path !== '/' &&
  !path.startsWith('/invitations/') &&
  !path.startsWith('/password-reset/') &&
  path !== '/register' &&
  !path.startsWith('/verify-email/') &&
  !path.startsWith('/user-invitations/') &&
  !isAdministrationPath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={text.metadata.description} />
    <Favicon />
    <title>{text.metadata.title}</title>
  </head>
  <body class={isCookbookPath ? 'cookbook-page' : undefined}>
    <HeadBar client:load locale={locale} />
    <main
      class={isAdministrationPath || isTenantManagementPath
        ? 'application-shell application-shell--admin'
        : 'application-shell'}
    >
      {
        path === '/' ? (
          <TenantSelection client:load locale={locale} />
        ) : path.startsWith('/invitations/') ? (
          <InvitationScreen
            client:load
            locale={locale}
            token={path.slice('/invitations/'.length)}
          />
        ) : path.startsWith('/password-reset/') ? (
          <PasswordResetScreen
            client:load
            text={text}
            token={path.slice('/password-reset/'.length)}
          />
        ) : path === '/register' ? (
          <RegistrationScreen client:load text={text} />
        ) : path.startsWith('/verify-email/') ? (
          <VerificationScreen client:load text={text} token={path.slice('/verify-email/'.length)} />
        ) : path.startsWith('/user-invitations/') ? (
          <UserInvitationScreen
            client:load
            locale={locale}
            token={path.slice('/user-invitations/'.length)}
          />
        ) : isAdministrationPath ? (
          <AdminArea client:load locale={locale} path={path} />
        ) : (
          <CookbookScreen client:load locale={locale} />
        )
      }
    </main>
    <BuildFooter buildCommit={deployedBuildCommit} text={text} />
  </body>
</html>
