---
interface Properties {
  name: string;
}

const { name }: Properties = Astro.props;
---

<header class="brand" aria-label={name}>
  <svg class="brand__logo" viewBox="0 0 112 112" aria-hidden="true">
    <g class="brand__utensils">
      <path class="brand__spoon-handle" d="m24 91 20-36" />
      <ellipse class="brand__spoon" cx="48" cy="48" rx="8" ry="11" transform="rotate(29 48 48)" />
      <path class="brand__spatula-handle" d="m87 91-14-35" />
      <path class="brand__spatula" d="m68 43 13-5 5 17-13 5Z" />
      <path class="brand__spatula-slots" d="m73 45 3 11m5-13 3 11" />
    </g>
    <path class="brand__body" d="M22 98c1-29 13-46 33-46s32 17 34 46Z" />
    <path class="brand__flipper" d="M30 69C15 71 9 83 10 95c8 1 18-4 26-15Z" />
    <path class="brand__flipper" d="M80 69c15 2 21 14 20 26-8 1-18-4-26-15Z" />
    <path class="brand__chef-hat" d="M31 52V39c-8-3-12-10-10-18 2-8 10-13 18-12 3-6 10-9 17-7 4-1 8-1 12 1 7-2 15 2 18 9 9-2 17 4 18 12 1 8-5 15-12 16v12Z" />
    <path class="brand__chef-hat-fold" d="M32 39c15 5 33 5 49 0" />
    <ellipse class="brand__face" cx="55" cy="72" rx="25" ry="22" />
    <path class="brand__mask" d="M32 68c4-18 41-18 46 0-2 8-9 16-23 17-14-1-21-9-23-17Z" />
    <path class="brand__cheek" d="M35 72c5-12 14-14 20-5-6 11-14 12-20 5Z" />
    <path class="brand__cheek" d="M75 72c-5-12-14-14-20-5 6 11 14 12 20 5Z" />
    <circle class="brand__eye" cx="46" cy="68" r="3.5" />
    <circle class="brand__eye" cx="64" cy="68" r="3.5" />
    <path class="brand__beak" d="m49 78 6 7 6-7-6-4Z" />
    <path class="brand__belly" d="M35 98c4-13 13-20 20-20s16 7 20 20Z" />
    <path class="brand__foot" d="M36 100c3-5 11-5 15 0Z" />
    <path class="brand__foot" d="M59 100c4-5 12-5 16 0Z" />
  </svg>
  <span>{name}</span>
</header>
