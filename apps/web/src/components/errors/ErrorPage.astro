---
import ErrorState from './ErrorState';
import Favicon from '../Favicon.astro';
import HeadBar from '../HeadBar';
import BuildFooter from '../BuildFooter.astro';
import { buildCommit } from '../../lib/server/build-info';
import { loadHeadBarSession, type HeadBarSession } from '../../lib/server/head-bar-session';
import { translations } from '../../i18n';
import type { Translation, Locale } from '../../i18n';
import '../../styles/global.css';
interface Props {
  locale: Locale;
  status: number;
  requestId?: string;
  retryAfterSeconds?: number;
}
const { locale, status, requestId, retryAfterSeconds } = Astro.props;
const text: Translation = translations[locale];
const deployedBuildCommit: string | undefined = buildCommit();
const headBarSession: HeadBarSession | undefined = await loadHeadBarSession(
  Astro.request.headers.get('cookie'),
  AbortSignal.timeout(1500),
).catch((): undefined => undefined);
---

<!doctype html>
<html lang={locale}>
  <head
    ><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta
      name="robots"
      content="noindex"
    /><Favicon /><title>{text.metadata.title}</title></head
  >
  <body>
    <HeadBar
      client:load
      currentPath={Astro.url.pathname}
      initialSession={headBarSession}
      locale={locale}
    />
    <main class="application-shell">
      <ErrorState
        client:load
        text={text.errorStates}
        status={status}
        requestId={requestId}
        retryAfterSeconds={retryAfterSeconds}
        returnTo={Astro.url.pathname + Astro.url.search}
      />
    </main>
    <BuildFooter buildCommit={deployedBuildCommit} text={text} />
  </body>
</html>
