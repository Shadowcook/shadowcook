# Copy to .env.db-clone. Values are literal, never executed as shell code.
# Use a read-only source account with access to every public table and sequence.
# The target must exist; its public schema is replaced with the test copy.
# Additional schemas and unrelated clients are allowed. Stop Shadowcook clients.
# Cross-schema dependencies damaged by replacement cause transaction rollback.
# Its account needs CREATEDB, target CREATE, public ownership, and permission to install copied extensions.
# Source public extensions are discovered; no current application schema is required.
# Use URLs reachable by the host PostgreSQL clients, including published ports.
# Percent-encode reserved characters in URL components. Quote values containing #.
# The shared test password is read before copying; do not store it in this file.
SOURCE_DATABASE_URL='postgresql://clone_reader:password@production-host:5432/shadowcook'
TARGET_DATABASE_URL='postgresql://test_owner:password@test-host:5432/shadowcook_test'
