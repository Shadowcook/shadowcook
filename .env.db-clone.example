# Copy to .env.db-clone. Values are literal, never executed as shell code.
# Use a read-only source account with access to every table and sequence.
# The target must exist, be dedicated to testing, and have no other connections.
# Its account needs CREATEDB, CREATE on the target database, and ownership of its public schema.
# Use URLs reachable by the host PostgreSQL clients, including published ports.
# Percent-encode reserved characters in URL components. Quote values containing #.
# The admin@local password is entered after import; do not store it in this file.
SOURCE_DATABASE_URL='postgresql://clone_reader:password@production-host:5432/shadowcook'
TARGET_DATABASE_URL='postgresql://test_owner:password@test-host:5432/shadowcook_test'
