# PostgreSQL connection string used by the API process and its startup migrations.
DATABASE_URL=postgresql://shadowcook:shadowcook@localhost:5432/shadowcook
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public Astro origin used in tenant invitation links.
PUBLIC_WEB_ORIGIN=http://localhost:4321
# Default UI language. Supported values: en, de.
PUBLIC_DEFAULT_LOCALE=en
# Development bootstrap credentials. They are created only when no instance administrator exists.
BOOTSTRAP_ADMIN_EMAIL=admin@local
# Base64-encoded 32-byte key used to encrypt operational secrets stored in PostgreSQL.
# Generate with: openssl rand -base64 32
# In a Docker deployment, prefer INSTANCE_SECRET_KEY_FILE=/run/secrets/instance_secret_key.
